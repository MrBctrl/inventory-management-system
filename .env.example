# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Local PostgreSQL (replace YOUR_POSTGRES_PASSWORD)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/inventory_management_dev
DATABASE_SSL=false

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=inventory_support

# Authentication (generate a private random secret; never commit your real .env)
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=1h
